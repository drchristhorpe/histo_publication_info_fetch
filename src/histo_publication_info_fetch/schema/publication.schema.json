{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BibJSON Publication Metadata",
  "description": "BibJSON format for PDB structure publications, combining structure metadata (PDBe) with journal details (Europe PMC)",
  "type": "object",
  "required": ["schema_version", "generated_at", "pdb_ids", "publications"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version (semver)"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the data was generated"
    },
    "pdb_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-z]{4}$"
      },
      "description": "List of PDB codes (lowercase)"
    },
    "publications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PublicationRecord"
      },
      "description": "List of publication records in BibJSON format"
    }
  },
  "$defs": {
    "Author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Author name"
        }
      }
    },
    "PublicationRecord": {
      "type": "object",
      "required": [
        "type",
        "title",
        "authors",
        "pdb_id",
        "release_date",
        "deposition_date",
        "experimental_method"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["article", "dataset"],
          "description": "Record type: 'article' if journal found, 'dataset' if structure-only"
        },
        "title": {
          "type": ["string", "null"],
          "description": "Publication title"
        },
        "authors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Author"
          },
          "description": "List of authors (BibJSON format)"
        },
        "year": {
          "type": ["integer", "null"],
          "description": "Publication year"
        },
        "journal": {
          "type": ["string", "null"],
          "description": "Journal title (null if not found in Europe PMC)"
        },
        "volume": {
          "type": ["string", "null"],
          "description": "Journal volume"
        },
        "issue": {
          "type": ["string", "null"],
          "description": "Journal issue"
        },
        "pages": {
          "type": ["string", "null"],
          "description": "Page range (e.g., '1234-1245')"
        },
        "doi": {
          "type": ["string", "null"],
          "description": "Digital Object Identifier"
        },
        "abstract": {
          "type": ["string", "null"],
          "description": "Publication abstract (from Europe PMC if available)"
        },
        "pdb_id": {
          "type": "string",
          "pattern": "^[0-9a-z]{4}$",
          "description": "PDB code (lowercase)"
        },
        "release_date": {
          "type": ["string", "null"],
          "format": "date",
          "description": "PDB release date (YYYY-MM-DD)"
        },
        "deposition_date": {
          "type": ["string", "null"],
          "format": "date",
          "description": "Deposition date (YYYY-MM-DD)"
        },
        "experimental_method": {
          "type": ["string", "null"],
          "description": "Experimental method used to solve the structure"
        }
      }
    }
  }
}
